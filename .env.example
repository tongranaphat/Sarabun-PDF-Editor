# ============================================
# Sarabun System - Template Configuration
# Rename this file to .env and fill in your values
# ============================================

# Database (Docker)
DB_PORT=5433
DB_NAME=document_management_db
DB_USER=postgres
DB_PASSWORD=REDACTED_CREDENTIAL

# Database Connection (Prisma)
# Replace placeholders with your actual values
DATABASE_URL="postgresql://postgres:REDACTED_CREDENTIAL@localhost:5432/document_management_db?schema=public"

# Server (Backend API)
SERVER_PORT=4011

# Client (Frontend)
CLIENT_PORT=5174

# Prisma Studio
PRISMA_PORT=5556

# VITE Public Vars (For Client)
VITE_API_PORT=4011
VITE_DEV_PORT=5174
VITE_SDC_DRY_RUN=true

# JWT Configuration
# Generate a secure secret for production
JWT_SECRET=REDACTED_CREDENTIAL
